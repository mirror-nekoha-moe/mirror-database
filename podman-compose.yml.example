services:
  # PostgreSQL Database
  # Modify variables to your likeness
  postgres:
    image: docker.io/library/postgres:16-alpine
    container_name: mirror-postgres
    restart: always
    env_file:
      - ./mirror-database/.env
    volumes:
      - ./mirror-database/postgres_data:/var/lib/postgresql/data:Z
    networks:
      - mirror-network
    ports:
      - "127.0.0.1:5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${PG_USERNAME} -d ${PG_DATABASE}"]
      interval: 10s
      timeout: 5s
      retries: 5
